<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- REPORT ACTION -->
    <record id="action_report_appointment_slip" model="ir.actions.report">
        <field name="name">Appointment Confirmation Slip</field>
        <field name="model">medical.appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adm_physiotherapy.report_appointment_slip_template</field>
        <field name="report_file">adm_physiotherapy.report_appointment_slip_template</field>
        <field name="binding_model_id" ref="adm_physiotherapy.model_medical_appointment"/>
        <field name="binding_type">report</field>

        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- SLIP TEMPLATE -->
    <template id="report_appointment_slip_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page"
                         style="font-family: 'Helvetica', 'Arial', sans-serif;
                                font-size: 13px;
                                color: #000;
                                max-width: 600px;
                                margin: auto;">

                        <!-- HEADER -->
                        <div style="border: 2px solid #000; padding: 12px; text-align:center;">
                            <h2 style="margin:0; letter-spacing:2px; font-weight:800;">
                                APPOINTMENT CONFIRMATION SLIP
                            </h2>
                            <div style="margin-top:4px; font-size:12px;">
                                Professional Medical Care
                            </div>
                        </div>

                        <!-- APPOINTMENT DETAILS TABLE -->
                        <table style="width:100%; border-collapse:collapse; margin-top:14px;"
                               border="1">
                            <tr style="background:#f7f7f7;">
                                <td style="padding:8px; width:40%;">
                                    <strong>Appointment No</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-esc="doc.appointment_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px;">
                                    <strong>Patient Name</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-esc="doc.patient_id.name"/>
                                </td>
                            </tr>
                            <tr style="background:#f7f7f7;">
                                <td style="padding:8px;">
                                    <strong>Patient No</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-esc="doc.patient_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px;">
                                    <strong>Doctor</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-esc="doc.doctor_id.name"/>
                                </td>
                            </tr>
                            <tr style="background:#f7f7f7;">
                                <td style="padding:8px;">
                                    <strong>Appointment Date</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-field="doc.appointment_date"
                                          t-options="{'widget': 'datetime'}"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px;">
                                    <strong>Status</strong>
                                </td>
                                <td style="padding:8px;">
                                    <span t-esc="dict(doc._fields['state'].selection).get(doc.state)"/>
                                </td>
                            </tr>
                            <tr style="background:#f7f7f7;">
                                <td style="padding:8px;">
                                    <strong>Consultation Fee</strong>
                                </td>
                                <td style="padding:8px;">
                                    ₹
                                    <span t-esc="doc.consultation_fee"/>
                                </td>
                            </tr>
                        </table>

                        <!-- QR CODE SECTION -->
                        <div style="margin-top:24px;">
                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <!-- QR 1: Book New Appointment -->
                                    <td style="width:50%; text-align:center; padding:12px;
                                               border:1px solid #ddd;">
                                        <strong style="font-size:12px;">📅 Book New Appointment</strong>
                                        <br/>
                                        <img t-att-src="'data:image/png;base64,%s' % doc.booking_qr_image.decode('utf-8')"
                                             width="120" height="120" style="margin-top:8px;"/>
                                        <br/>
                                        <small style="font-size:9px; color:#666;">
                                            Scan to book a new appointment
                                        </small>
                                    </td>

                                    <!-- QR 2: View This Appointment -->
                                    <td style="width:50%; text-align:center; padding:12px;
                                               border:1px solid #ddd;">
                                        <strong style="font-size:12px;">📋 View This Appointment</strong>
                                        <br/>
                                        <img t-att-src="'data:image/png;base64,%s' % doc.appointment_qr_image.decode('utf-8')"
                                             width="120" height="120" style="margin-top:8px;"/>
                                        <br/>
                                        <small style="font-size:9px; color:#666;">
                                            Scan to view appointment details
                                        </small>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- FOOTER NOTE -->
                        <div style="margin-top:20px; border-top:1px solid #000;
                                    padding-top:10px; text-align:center; font-size:11px;
                                    color:#555;">
                            Please arrive 10 minutes before your scheduled appointment time.
                            <br/>
                            For cancellations, visit your appointment portal or scan the QR above.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>