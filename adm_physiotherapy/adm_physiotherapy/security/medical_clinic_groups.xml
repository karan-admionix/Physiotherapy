<odoo>

    <record id="group_medical_patient" model="res.groups">
        <field name="name">Patient</field>
    </record>

    <record id="group_medical_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="implied_ids" eval="[(4, ref('adm_physiotherapy.group_medical_patient'))]"/>
    </record>

    <record id="group_medical_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('adm_physiotherapy.group_medical_doctor'))]"/>
    </record>


</odoo>
