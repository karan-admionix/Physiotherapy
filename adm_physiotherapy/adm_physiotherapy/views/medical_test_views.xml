<odoo>

    <!-- Medical Test List -->
    <record id="view_physio_medical_test_list" model="ir.ui.view">
        <field name="name">physio.medical.test.list</field>
        <field name="model">physio.medical.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="test_name"/>
                <field name="test_date"/>
                <field name="patient_id"/>
            </list>
        </field>
    </record>

    <!-- Medical Test Form -->
    <record id="view_physio_medical_test_form" model="ir.ui.view">
        <field name="name">physio.medical.test.form</field>
        <field name="model">physio.medical.test</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name" readonly="id"/>
                        <field name="test_name"/>
                        <field name="test_date"/>
                    </group>

                    <group>
                        <field name="patient_id"/>
                        <field name="prescription_id"/>
                    </group>

                    <group>
                        <field name="result"/>
                        <field name="remarks"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Medical Test Action -->
    <record id="action_physio_medical_test" model="ir.actions.act_window">
        <field name="name">Medical Tests</field>
        <field name="res_model">physio.medical.test</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_physio_medical_test_list'), 'list'),
            (ref('view_physio_medical_test_form'), 'form')
        ]"/>
    </record>

</odoo>
