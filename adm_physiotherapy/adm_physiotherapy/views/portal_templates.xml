<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="adm_physiotherapy_portal_my_home" name="Physiotherapy in Portal" inherit_id="portal.portal_my_home"
              priority="40" customize_show="True">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div class="o_portal_docs row g-2">
                <div class="o_portal_category row g-2 mt-3 id=adm_physiotherapy_portal_my_home">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/adm_physiotherapy/static/src/img/bill.svg'"/>
                        <t t-set="text">Check Your Appoinments Here</t>
                        <!--                         <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>-->
                        <t t-set="url" t-value="'/my/appointments'"/>
                        <t t-set="title">Appointments</t>
                        <t t-set="placeholder_count" t-value="'appointment_count'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>

                <!-- You can add more cards here later -->
            </div>
        </xpath>
    </template>

</odoo>
