<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Override Odoo's default appointment entry and replace its content with ours -->
    <template id="disable_default_appointment_portal"
              inherit_id="appointment.portal_my_home_appointment">
        <xpath expr="//t[@t-call='portal.portal_docs_entry']" position="replace">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/adm_physiotherapy/static/src/img/appoi.svg'"/>
                <t t-set="text">Check Your Appoinments Here</t>
                <t t-set="url" t-value="'/my/appointments'"/>
                <t t-set="title">Appointments</t>
                <t t-set="placeholder_count" t-value="'appointment_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

</odoo>

